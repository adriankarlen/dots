{
  // Default posture: let the agent work uninterrupted; only ask/deny for
  // genuinely destructive or sensitive-data operations.
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "allow",
    "skills": "allow",
    "special": "ask"
  },

  "tools": {
    "*": "allow",

    // Sensitive-file guards: never silently read/write/edit secrets or keys,
    // regardless of where they live. (credential-handling / secret-detection
    // categories) to cover the common credential stores.
    "read:*.env": "deny",
    "read:*.env.*": "deny",
    "read:*/.ssh/*": "deny",
    "read:*/.gnupg/*": "deny",
    "read:*/.aws/*": "deny",
    "read:*/.kube/*": "deny",
    "read:*/.docker/config.json": "deny",
    "read:*/.config/gcloud/*": "deny",
    "read:*/.azure/*": "deny",
    "read:*/.netrc": "deny",
    "read:*/.npmrc": "deny",
    "read:*/.pypirc": "deny",
    "read:*/.config/gh/hosts.yml": "deny",
    "read:*/.config/op/*": "deny",
    "read:*Local State": "deny",
    "read:*/Cookies": "deny",
    "read:*wallet.dat": "deny",
    "read:*/.electrum/*": "deny",
    "write:*.env": "deny",
    "write:*.env.*": "deny",
    "write:*/.ssh/*": "deny",
    "write:*/.gnupg/*": "deny",
    "write:*/.aws/*": "deny",
    "write:*/.kube/*": "deny",
    "write:*/.docker/config.json": "deny",
    "write:*/.config/gcloud/*": "deny",
    "write:*/.azure/*": "deny",
    "write:*/.netrc": "deny",
    "write:*/.npmrc": "deny",
    "write:*/.pypirc": "deny",
    "edit:*.env": "deny",
    "edit:*.env.*": "deny",
    "edit:*/.ssh/*": "deny",
    "edit:*/.gnupg/*": "deny",
    "edit:*/.aws/*": "deny",
    "edit:*/.kube/*": "deny",
    "edit:*/.docker/config.json": "deny",
    "edit:*/.netrc": "deny",
    "edit:*/.npmrc": "deny",

    // System/persistence surfaces malicious skills like to touch
    "write:/etc/systemd/system/*": "deny",
    "edit:/etc/systemd/system/*": "deny",
    "write:*/.bashrc": "ask",
    "write:*/.zshrc": "ask",
    "write:*/.profile": "ask",
    "edit:*/.bashrc": "ask",
    "edit:*/.zshrc": "ask",
    "edit:*/.profile": "ask",

    // .env.example etc. are fine to read/edit.
    "read:*.env.example": "allow",
    "write:*.env.example": "allow",
    "edit:*.env.example": "allow"
  },

  "bash": {
    "*": "allow",

    // Hard blocks: irreversible / system-damaging, no legitimate uninterrupted use case.
    "rm -rf *": "deny",
    "rm -rf /*": "deny",
    "rm -rf ~*": "deny",
    "rm -fr *": "deny",
    "sudo *": "deny",
    "mkfs*": "deny",
    "dd of=/dev/": "deny",
    "chmod -R 777 /*": "deny",
    "chown -R *": "ask",
    "🙁){ :|:& };:": "deny",

    // Base64 (and similar) encoding/decoding on the command line is a
    // near-universal marker of obfuscated exfiltration/payload-smuggling in
    // malicious skills. Never allow it silently.
    "base64": "deny",
    "base32": "deny",
    "xxd -r": "deny",
    "openssl enc": "deny",

    // Remote-code-execution / "unverifiable dependency" patterns: fetching a
    // script and piping it straight into an interpreter, or dynamically
    // importing/eval'ing remote content.
    "curl * | bash": "deny",
    "curl * | sh": "deny",
    "curl * | zsh": "deny",
    "curl * | python*": "deny",
    "curl * | node": "deny",
    "wget * | bash": "deny",
    "wget * | sh": "deny",
    "eval \"$(curl": "deny",
    "eval $(curl": "deny",
    "eval \"$(wget": "deny",
    "source <(curl": "deny",
    "source <(wget": "deny",
    "* | curl *": "deny",
    "* | nc *": "deny",

    // Reverse shells / raw network backdoors.
    "bash -i >&": "deny",
    "/dev/tcp/": "deny",
    "*nc -e *": "deny",
    "*ncat -e *": "deny",
    "*mkfifo *": "ask",

    // Persistence mechanisms favored by malicious skills (systemd/cron
    // backdoors per the report's "security disablement" category).
    "crontab -e*": "ask",
    "crontab -r*": "ask",
    "*crontab *": "ask",
    "systemctl enable *": "ask",
    "systemctl service": "ask",

    // Security-control disablement.
    "setenforce 0": "deny",
    "iptables -F": "ask",
    "ufw disable": "ask",
    "*chattr -i *": "ask",

    // Anti-forensics / covering tracks.
    "history -c*": "ask",
    "unset HISTFILE": "ask",

    // Password-protected archives are a classic scanner-evasion technique.
    "unzip -P *": "ask",
    "7z*-p": "ask",

    // Ambiguous but potentially destructive: confirm instead of blanket allow/deny.
    "git push --force*": "ask",
    "git push -f *": "ask",
    "git reset --hard*": "ask",
    "git clean -fd*": "ask"
  },

  "mcp": {
    "*": "allow"
  },

  "skills": {
    "*": "allow"
  },

  "special": {
    "doom_loop": "ask",
    "external_directory": "ask"
  }
}
