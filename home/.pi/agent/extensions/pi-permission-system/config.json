{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,

  "permission": {
    // Default posture: let the agent work uninterrupted; only ask/deny for
    // genuinely destructive or sensitive-data operations.
    "*": "allow",

    // Cross-cutting credential/secret guard: never silently read/write/edit
    // secrets or keys through ANY tool (built-in file tools, bash, MCP),
    // regardless of where they live. This is a strict upgrade over gating
    // read/write/edit separately -- it also covers bash (cat/cp/echo>...)
    // and MCP/extension tools that touch a path.
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/config.json": "deny",
      "*/.config/gcloud/*": "deny",
      "*/.azure/*": "deny",
      "*/.netrc": "deny",
      "*/.npmrc": "deny",
      "*/.pypirc": "deny",
      "*/.config/gh/hosts.yml": "deny",
      "*/.config/op/*": "deny",
      "*Local State": "deny",
      "*/Cookies": "deny",
      "*wallet.dat": "deny",
      "*/.electrum/*": "deny",
      // .env.example etc. are fine to read/edit -- must come after the
      // *.env.* deny above so last-match-wins picks the allow.
      "*.env.example": "allow"
    },

    // Write/edit: only secrets (via the "path" map above) are blocked;
    // everything else, including shell rc files, is approved without asking.
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },

    "bash": {
      "*": "allow",

      // Hard blocks only: irreversible whole-filesystem/home destruction,
      // disk-level wipes, fork bombs, reverse shells, and remote-code-
      // execution-by-pipe. Everything else (sudo, crontab, git push --force,
      // chown -R, archive passwords, etc.) is approved without asking.
      "rm -rf *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -fr *": "deny",
      "sudo rm -rf*": "deny",
      "mkfs*": "deny",
      "sudo mkfs*": "deny",
      "dd of=/dev/": "deny",
      "sudo dd of=/dev/": "deny",
      "chmod -R 777 /*": "deny",
      "sudo chmod -R 777 /*": "deny",
      "🙁){ :|:& };:": "deny",

      // Remote-code-execution patterns: fetching a script and piping it
      // straight into an interpreter, or eval'ing remote content. This is
      // as "obviously malicious" as filesystem wipes -- it hands over full
      // code execution to whatever the remote URL happens to serve.
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "curl * | zsh": "deny",
      "curl * | python*": "deny",
      "curl * | node": "deny",
      "wget * | bash": "deny",
      "wget * | sh": "deny",
      "eval \"$(curl": "deny",
      "eval $(curl": "deny",
      "eval \"$(wget": "deny",
      "source <(curl": "deny",
      "source <(wget": "deny",
      "* | curl *": "deny",
      "* | nc *": "deny",

      // Reverse shells / raw network backdoors.
      "bash -i >&": "deny",
      "/dev/tcp/": "deny",
      "*nc -e *": "deny",
      "*ncat -e *": "deny"
    },

    "mcp": "allow",
    "skill": "allow",

    // CWD-boundary gate: also approved by default now. The "path" secret
    // guard above still applies regardless of whether a path is inside or
    // outside the working directory.
    "external_directory": {
      "*": "allow"
    }
  }
}
