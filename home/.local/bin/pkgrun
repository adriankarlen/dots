#!/bin/bash
# pkgrun <script> [args...]: run a package.json script with aube. aube reads
# and writes whichever lockfile exists on disk (pnpm-lock.yaml, package-lock.json,
# yarn.lock, bun.lock) in place, so this is package-manager-agnostic, and it
# auto-installs on stale state before running the script. Works in monorepo
# packages since it runs in the current directory.

if [ $# -eq 0 ]; then
  echo "Usage: pkgrun <script> [args...]" >&2
  exit 2
fi

exec aube run "$@"
